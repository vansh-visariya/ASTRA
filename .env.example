# ASTRA Environment Variables
# Copy this file to .env and fill in your values.

# --- Required ---

# JWT signing secret (used by auth.py: os.getenv("SECRET_KEY"))
# Generate a strong random key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev_secret_key_change_in_production

# Environment: dev | prod (used by auth.py and server_api.py)
ENV=dev

# --- Database ---

# Path to the SQLite database file (used by config.py: os.environ.get("DB_PATH"))
DB_PATH=./astra.db

# --- Optional ---

# Gemini API Key for AI-powered model recommendations
# Get your free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server host and port (used by server_api.py)
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Default admin password for fresh database initialization
# Used by database.py when creating the admin user on first run
ASTRA_DEFAULT_ADMIN_PASSWORD=adminpass

# Random seed for reproducibility (used by config.py)
# Set to a fixed integer for deterministic results across runs
# ASTRA_SEED=42
